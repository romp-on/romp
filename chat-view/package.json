{
  "name": "romp-chat-view",
  "displayName": "romp Chat View",
  "description": "Read-only, nicely-rendered live view of Claude Code (romp) sessions, styled like the official Claude Code panel.",
  "version": "0.4.269",
  "publisher": "romp",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:rompChat",
    "onWebviewPanel:rompFeed",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rompChat.open",
        "title": "romp: Open",
        "icon": "media/romp-swirl-glyph.svg"
      },
      {
        "command": "rompChat.addSession",
        "title": "romp: Add Session Tab",
        "icon": "$(add)"
      },
      {
        "command": "rompChat.openCurrent",
        "title": "romp: View This Transcript File"
      },
      {
        "command": "rompChat.nextTab",
        "title": "romp: Next Tab"
      },
      {
        "command": "rompChat.prevTab",
        "title": "romp: Previous Tab"
      },
      {
        "command": "rompChat.openAll",
        "title": "romp: Open All Running Sessions"
      },
      {
        "command": "rompChat.pickSession",
        "title": "romp: Pick a Session"
      },
      {
        "command": "rompChat.openFeed",
        "title": "romp: Open Feed",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rompChat.open",
          "group": "navigation@99"
        },
        {
          "command": "rompChat.openFeed",
          "group": "navigation@98",
          "when": "activeWebviewPanelId == 'rompChat' || activeWebviewPanelId == 'rompFeed'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rompChat.nextTab",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.prevTab",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.nextTab",
        "mac": "ctrl+cmd+alt+right",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.prevTab",
        "mac": "ctrl+cmd+alt+left",
        "when": "activeWebviewPanelId == 'rompChat'"
      }
    ],
    "configuration": {
      "title": "romp",
      "properties": {
        "romp.kernelPort": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port of the romp kernel this VS Code window attaches to. Point different windows at different ports to view different kernels (each kernel scopes its own group of agents). If no kernel is running on this port, VS Code asks the `romp --on` manager to start one — VS Code never spawns the kernel itself. Unset → `$ROMP_SERVE_PORT` or **7433**."
        },
        "romp.managerPort": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Control-endpoint port of the `romp --on` manager, used to ensure a kernel exists on `#romp.kernelPort#`. Unset → `$ROMP_MANAGER_PORT` or **7432**."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production",
    "test": "node esbuild.js --tests && node --test 'out-tests/**/*.test.js'",
    "gallery": "node ../bin/romp-gallery"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.10",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "ws": "^8.21.0"
  }
}
