#!/usr/bin/env bash
# usage: romp-login-setup <1password-vault> <label> [--check]
set -euo pipefail; umask 077
VAULT=""; LABEL=""; CHECK=0
for a in "$@"; do case "$a" in --check) CHECK=1 ;; -*) echo "usage: $0 <1password-vault> <label> [--check]" >&2; exit 2 ;; *) if [ -z "$VAULT" ]; then VAULT="$a"; elif [ -z "$LABEL" ]; then LABEL="$a"; else echo "usage: $0 <1password-vault> <label> [--check]" >&2; exit 2; fi ;; esac; done
[ -n "$VAULT" ] && [ -n "$LABEL" ] || { echo "usage: $0 <1password-vault> <label> [--check]" >&2; exit 2; }
case "$LABEL" in *[!A-Za-z0-9\ _-]*) echo "the label may use letters, digits, spaces, dashes and underscores only (it names the 1Password item and romp's reference to it)" >&2; exit 1 ;; esac
{ romp login add 2>&1 || true; } | grep -q 'romp login add <label>' || { echo "this romp has no 'login add' yet: deploy the stored-logins change first" >&2; exit 1; }
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
# 1. sign in to the second account under a scratch configuration and mint the token; the token is masked on screen
CLAUDE_CONFIG_DIR="$work/claude" claude setup-token | tee "$work/out" | awk '{ gsub(/sk-ant-[A-Za-z0-9_.-]+/, "<token captured>"); print; fflush() }'
grep -oE 'sk-ant-(oat|ort)[0-9]{2}-[A-Za-z0-9_.-]{20,}' "$work/out" | head -1 > "$work/token" || true
[ -s "$work/token" ] || { echo "no token was printed" >&2; exit 1; }
# 2. store it in 1Password as an API Credential item named after the label
printf '{"title":"%s","category":"API_CREDENTIAL","fields":[{"id":"credential","type":"CONCEALED","label":"credential","value":"%s"}]}' "$LABEL" "$(cat "$work/token")" > "$work/item.json"
op item create --vault "$VAULT" --template "$work/item.json" >/dev/null
# 3. tell romp about the login (needs the stored-logins change deployed)
romp login add "$LABEL" --op "op://$VAULT/$LABEL/credential"
[ "$CHECK" -eq 1 ] || exit 0
# --check: Claude Code must accept the stored token through a helper, with the environment's credential variables removed, and refuse a junk helper
printf '#!/bin/sh\nexec op read --no-newline "op://%s/%s/credential"\n' "$VAULT" "$LABEL" > "$work/helper"; printf '#!/bin/sh\necho not-a-real-credential\n' > "$work/junk"; chmod 700 "$work/helper" "$work/junk"
ask() { printf '{"apiKeyHelper":"%s"}' "$1" > "$work/settings.json"; env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN -u CCR_OAUTH_TOKEN_FILE -u CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR -u ANTHROPIC_CUSTOM_HEADERS claude -p 'Reply with the single word ok and nothing else.' --settings "$work/settings.json"; }
ask "$work/helper" 2>/dev/null | grep -qi ok || { echo "check failed: the stored token was not accepted" >&2; exit 1; }
! ask "$work/junk" >/dev/null 2>&1 || { echo "check failed: a junk helper was also accepted" >&2; exit 1; }
echo "check passed"
