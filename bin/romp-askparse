#!/usr/bin/env python3
"""romp-askparse — parse the Claude Code selection picker out of a captured tmux pane.

A faithful Python port of chat-view/src/askparse.ts (the TypeScript parser used
by the webview). A pending AskUserQuestion (and tool-permission) prompt lives
ONLY in the TUI's on-screen state — Claude Code does not write it to the
transcript JSONL until it's answered. So the chat view, which mirrors the
transcript, is structurally blind to it; we capture the pane
(`tmux capture-pane -p`) and parse the picker here.

The picker is a small state machine (verified empirically against the TUI):

 - SINGLE-select — standard footer; rows `❯ N. label`; ↑/↓ move, Enter picks.
 - MULTI-select selection screen ("Multi-pick" tab) — standard footer; a tab
   bar `←  ☒ Header  ✔ Submit  →`; rows carry a checkbox `❯ N. [✔]/[ ] label`.
 - MULTI-select submit/review screen ("Submit" tab) — NO footer; "Submit answers".
 - MULTI-QUESTION wizard — one ☐/☒ tab per question plus ✔ Submit; each question
   screen is single-select unless its rows carry checkboxes.
 - Footer-LESS confirmation ("PATH C", e.g. /model's "Switch model?" prompt).
 - Side-by-side preview boxes — clipped off the option column, kept verbatim.

`parse_ask_pane(pane, cols=None)` returns a dict mirroring the TS `ParsedAsk`
shape (camelCase keys: kind, header, question, options, cursor, cursorFound,
chosen, pairs, multiSelect, preview, sig) or None for a non-picker screen. Keys
match the TS field names EXACTLY because the kernel sends this dict verbatim to
the webview, which expects that shape.

Each option dict mirrors the TS `AskOption`:
  n (int, 1-based ordinal as the TUI numbers it), label (str), desc (str or
  absent), selected (bool, the ❯ cursor is on this row), checked (bool or
  absent, multi-select checkbox state).
"""
import re

OPT_RE = re.compile(r"^\s*(❯)?\s*(\d+)\.\s+(.*\S)\s*$")   # ❯? N. label
CHECK_RE = re.compile(r"^\[\s*([^\]]?)\s*\]\s*(.*)$")     # [✔] label / [ ] label
# A separator rule: a solid run of dashes (─/-) OR a SPACED dashed line
# (`─ ─ ─ …`, which Claude Code uses between the prior turn and a footer-less
# confirmation). Both must start the line; the `\s?` lets single gaps in without
# matching prose that merely contains a hyphen (a second dash must follow).
RULE_RE = re.compile(r"^\s*(?:[─-]\s?){3,}.*$")
HEADER_RE = re.compile(r"^\s*[☐☑▣▢]\s+(.+?)\s*$")
FOOTER_RE = re.compile(r"to navigate|Enter to select|Esc to (cancel|exit)")
# The normal composer/status footer — its presence anywhere means the pane is at
# the message box, NOT a pending footer-less confirmation (PATH C below).
COMPOSER_RE = re.compile(r"⏵⏵|shift\s*\+\s*tab to cycle|auto mode (on|off)|\bctx:\s*\d+%")

# The diff frame in an Edit/Write/MultiEdit permission prompt is fenced by a row
# of ╌ (U+254C) / ┄ (U+2504) dashes — distinct from the ─ box border above. The
# diff body sits between two such fences; each line is `<lineno> <marker><text>`
# (marker: '-' deleted, '+' added, ' ' context).
DIFF_FENCE_RE = re.compile(r"^\s*[╌┄]{3,}\s*$")
# A numbered diff line: "<lineno> <rest>". Group 1 is everything after the line
# number + its single separator space, right-trimmed of the TUI's width padding.
DIFF_NUM_RE = re.compile(r"^\s*\d+\s(.*?)\s*$")
BOX_TOP_RE = re.compile(r"^\s*╭")
BOX_BOT_RE = re.compile(r"^\s*╰")

# Side-by-side preview: match VERTICAL and CORNER box glyphs ONLY — never
# horizontals (─━═) or the em/en dashes that legitimately appear in a diagram.
BOX_EDGE_RE = re.compile(r"[│┃┆┇┊┋╎╏║▏▕╭╮╯╰┌┐┘└┏┓┛┗╔╗╝╚├┤┣┫╠╣]")

_CHECKED_RE = re.compile(r"[✔✓xX]")
_TABBAR_ARROW_RE = re.compile(r"[←→]")
_TABBAR_KIND_RE = re.compile(r"Submit|☒|✔|☑")
_INDENT_RE = re.compile(r"^\s")


def is_opt(line):
    return OPT_RE.match(line) is not None


def is_rule(line):
    return RULE_RE.match(line) is not None


def is_blank(line):
    return line.strip() == ""


def is_indented(line):
    return _INDENT_RE.match(line) is not None and line.strip() != ""


# The `←  ☒ Header  ✔ Submit  →` tab bar (multi-select AND the wizard).
def is_tab_bar(line):
    return _TABBAR_ARROW_RE.search(line) is not None and _TABBAR_KIND_RE.search(line) is not None


def is_diff_fence(line):
    return DIFF_FENCE_RE.match(line) is not None


def is_box_edge(line):
    return BOX_TOP_RE.match(line) is not None or BOX_BOT_RE.match(line) is not None or re.match(r"^\s*│", line) is not None


def _strip_box(s):
    """Remove │-border from a boxed line."""
    return re.sub(r"\s*│\s*$", "", re.sub(r"^\s*│\s?", "", s))


def _lead_ws(s):
    m = re.match(r"^(\s*)", s)
    return len(m.group(1)) if m else 0


def find_diff_region(lines, end_idx):
    """Find a ╌-fenced or ╭-boxed diff region before end_idx.

    Returns (frame_top, start, end, strip_fn) or None. strip_fn maps a raw line
    to its inner content (identity for ╌-fences, border-strip for boxes).
    """
    fences = [i for i in range(end_idx) if is_diff_fence(lines[i])]
    if len(fences) >= 2:
        return (fences[0], fences[0] + 1, fences[-1], lambda s: s)
    top = -1
    bot = -1
    for i in range(end_idx):
        if top < 0:
            if BOX_TOP_RE.match(lines[i]):
                top = i
        elif BOX_BOT_RE.match(lines[i]):
            bot = i
            break
    if top >= 0 and bot > top:
        return (top, top + 1, bot, _strip_box)
    return None


def extract_diff_block(lines, end_idx):
    """Pull the framed diff (and file header) out of a permission pane.

    Returns a dict with optional keys: diff, fileHead, planBody.

    Each diff line is `<lineno> <marker><text>` -> emit "-text" / "+text" / "  text"
    (a unified diff the webview colors). A line with NO line number is a soft-wrap
    continuation and folds into the previous.

    New-file Writes have NO marker column -- line numbers sit directly before
    content -- so `- item` (a markdown bullet) would be misread as a deletion.
    The marker column exists ONLY when EVERY numbered line begins with "+", "-",
    or space.

    When a rounded box holds no numbered diff lines, its content is plan markdown
    (ExitPlanMode) -- returned as planBody, not as a diff.
    """
    region = find_diff_region(lines, end_idx)
    if not region:
        return {}
    frame_top, start, end, strip_fn = region
    # header ABOVE the frame: from the nearest ─ rule down to the frame.
    h_start = 0
    for i in range(frame_top - 1, -1, -1):
        if is_rule(lines[i]):
            h_start = i + 1
            break
    above = []
    for i in range(h_start, frame_top):
        t = lines[i]
        if not is_blank(t) and not is_rule(t) and not is_diff_fence(t):
            above.append(t.strip())
    # inner lines: numbered lines are the diff; non-numbered lines BEFORE the
    # first diff row are the in-box header (NotebookEdit's path + subtitle).
    rows = []         # list of rest strings (content after "<lineno> ")
    in_box_head = []
    inner_raw = []
    for i in range(start, end):
        t = strip_fn(lines[i])
        inner_raw.append(t.rstrip())
        if is_diff_fence(t):
            continue
        m = DIFF_NUM_RE.match(t)
        if m:
            rows.append(m.group(1))  # rest (marker column kept)
        elif rows and t.strip():
            rows[-1] += " " + t.strip()  # soft-wrap continuation
        elif not rows and t.strip():
            in_box_head.append(t.strip())  # in-box header line
    above_head = "\n".join(above) if above else None
    # No numbered lines -> the box is markdown (a plan), not a diff.
    if not rows:
        plan_body = "\n".join(inner_raw).strip()
        result = {}
        if above_head:
            result["fileHead"] = above_head
        if plan_body:
            result["planBody"] = plan_body
        return result
    file_head_parts = above + in_box_head
    file_head = "\n".join(file_head_parts) if file_head_parts else None
    marked = [r for r in rows if r != ""]
    has_marker_col = len(marked) > 0 and all(r[0] in ("+", "-", " ") for r in marked)
    out = []
    for r in rows:
        if not has_marker_col:
            out.append("+" + r)  # new file: whole line is an addition
        elif r == "":
            out.append("  ")     # blank context line
        else:
            mk = r[0]
            if mk in ("+", "-"):
                out.append(mk + r[1:])
            else:
                out.append("  " + r[1:])
    result = {}
    result["diff"] = "\n".join(out)
    if file_head:
        result["fileHead"] = file_head
    return result


def split_above(lines, first_opt_idx):
    """Split the lines above the option block into header, question, body, and diff fields.

    Blank lines break the region into blocks; the block nearest the options seeds
    the QUESTION. A block above it that's indented DEEPER than the question is the
    detail BODY (WebFetch url+prompt, Bash command, MCP call); a same-or-less-
    indented block is more question text and folds in.
    """
    header = None
    blocks = []  # bottom-up; lines bottom-up within a block
    cur = None
    floor = max(0, first_opt_idx - 40)
    for k in range(first_opt_idx - 1, floor - 1, -1):
        t = lines[k]
        if is_rule(t) or is_diff_fence(t) or is_box_edge(t):
            break
        if is_blank(t):
            if cur:
                blocks.append(cur)
                cur = None
            continue
        if is_tab_bar(t):
            h = re.search(r"☐\s*([^☐☒✔✓→]+?)\s+[☐☒✔✓]", t) or \
                re.search(r"[☐☒]\s*([^☐☒✔✓→]+?)\s+[☐☒✔✓]", t)
            if h and not header:
                header = h.group(1).strip()
            continue
        hm = HEADER_RE.match(t)
        if hm and not header:
            header = hm.group(1).strip()
            continue
        if not cur:
            cur = {"lines": [t.strip()], "indent": _lead_ws(t)}
        else:
            cur["lines"].append(t.strip())
            cur["indent"] = min(cur["indent"], _lead_ws(t))
    if cur:
        blocks.append(cur)

    question_lines = []
    body = None
    if blocks:
        q_indent = blocks[0]["indent"]
        question_lines = list(reversed(blocks[0]["lines"]))  # top-down
        for i in range(1, len(blocks)):
            if blocks[i]["indent"] > q_indent:
                body = "\n".join(reversed(blocks[i]["lines"]))
                break
            question_lines = list(reversed(blocks[i]["lines"])) + question_lines
    diff_result = extract_diff_block(lines, first_opt_idx)
    return {
        "header": header,
        "question": " ".join(question_lines) if question_lines else None,
        "body": body,
        "diff": diff_result.get("diff"),
        "fileHead": diff_result.get("fileHead"),
        "planBody": diff_result.get("planBody"),
    }


def preview_border_col(lines):
    """Column of a side-by-side preview box's LEFT border, or -1 when none.

    The left border is the leftmost glyph on its row, so we take the FIRST box
    edge per line; a genuine box spans >=4 rows at one fixed column. Anything
    from that column rightward is preview, not options.
    """
    hits = {}
    for ln in lines:
        for c in range(len(ln)):
            if BOX_EDGE_RE.match(ln[c]):
                hits[c] = hits.get(c, 0) + 1
                break
    col = -1
    for c, n in hits.items():
        if c > 0 and n >= 4 and (col == -1 or c < col):
            col = c
    return col


def gap_is_skippable(lines, a, b):
    for i in range(a + 1, b):
        t = lines[i]
        if is_blank(t) or is_rule(t) or (is_indented(t) and not is_opt(t)):
            continue
        return False
    return True


def option_block(lines, end_idx):
    """The contiguous block of numbered option rows nearest end_idx (exclusive),
    excluding earlier prose numbering (gaps must be blank/rule/description)."""
    candidates = []
    for i in range(end_idx):
        if is_opt(lines[i]):
            candidates.append(i)
    if not candidates:
        return []
    block = [candidates[-1]]
    for k in range(len(candidates) - 2, -1, -1):
        if gap_is_skippable(lines, candidates[k], block[0]):
            block.insert(0, candidates[k])
        else:
            break
    return block


def parse_options(lines, block, end_idx):
    options = []
    cursor = 0
    cursor_found = False
    has_checkbox = False
    for bi in range(len(block)):
        idx = block[bi]
        m = OPT_RE.match(lines[idx])
        if not m:
            continue
        selected = bool(m.group(1))
        n = int(m.group(2))
        label = (m.group(3) or "").strip()
        checked = None
        cm = CHECK_RE.match(label)
        if cm:
            checked = _CHECKED_RE.search(cm.group(1)) is not None
            label = cm.group(2).strip()
            has_checkbox = True
        end = block[bi + 1] if bi + 1 < len(block) else end_idx
        desc = []
        for j in range(idx + 1, end):
            t = lines[j]
            if is_blank(t) or is_rule(t) or is_opt(t):
                continue
            if is_indented(t):
                desc.append(t.strip())
        if selected:
            cursor = n
            cursor_found = True
        opt = {"n": n, "label": label, "selected": selected}
        if desc:
            opt["desc"] = " ".join(desc)
        if checked is not None:
            opt["checked"] = checked
        options.append(opt)
    if not cursor and options:
        cursor = options[0]["n"]
    return {"options": options, "cursor": cursor, "cursorFound": cursor_found, "hasCheckbox": has_checkbox}


def _mk(kind, header, question, opts, preview=None, chosen=None, pairs=None,
         diff=None, body=None, file_head=None, plan_body=None):
    sig_opts = "|".join(
        "%s:%s:%s" % (o["n"], o["label"], "" if o.get("checked") is None else ("x" if o["checked"] else "o"))
        for o in opts["options"]
    )
    sig = "§".join([
        kind, header or "", question or "",
        sig_opts,
        "cur%s" % opts["cursor"],
        ",".join(chosen or []),
        ";".join("%s=%s" % (p["q"], p["a"]) for p in (pairs or [])),
        ("pv%d:%s" % (len(preview), preview)) if preview else "",
        ("diff:%d" % len(diff)) if diff else "",
        ("body:%d" % len(body)) if body else "",
        ("fh:%d" % len(file_head)) if file_head else "",
        ("plan:%d" % len(plan_body)) if plan_body else "",
    ])
    result = {
        "kind": kind,
        "header": header,
        "question": question,
        "options": opts["options"],
        "cursor": opts["cursor"],
        "cursorFound": opts["cursorFound"],
        "chosen": chosen,
        "pairs": pairs,
        "multiSelect": kind == "multi",
        "preview": preview,
        "sig": sig,
    }
    if diff is not None:
        result["diff"] = diff
    if file_head is not None:
        result["fileHead"] = file_head
    if body is not None:
        result["body"] = body
    if plan_body is not None:
        result["planBody"] = plan_body
    return result


def extract_preview(lines, bcol):
    """The preview BOX only — the rows spanning its top border to its bottom border, sliced at the
    left-border column (bcol) and kept VERBATIM. The inverse of the clip at parse_ask_pane.

    Slicing EVERY line at bcol (the old behaviour) bled the left-clipped TAILS of unrelated on-screen
    lines — the wrapped question above the box, the footer below it, the chat behind — into the
    preview, which the user saw as garbled clipped text (the user 2026-06-16). The box's own rows are
    exactly those carrying a box-edge glyph at bcol; restrict to the span between the first and last."""
    box = [i for i, ln in enumerate(lines) if len(ln) > bcol and BOX_EDGE_RE.match(ln[bcol])]
    if not box:
        return None
    col = [lines[i][bcol:].rstrip() if len(lines[i]) > bcol else "" for i in range(box[0], box[-1] + 1)]
    return "\n".join(col) if col else None


def parse_ask_pane(pane, cols=None):
    text = pane
    if not text:
        return None
    raw = text.replace("\r", "").split("\n")
    # Clip a side-by-side preview box so its text can't bleed into the options.
    bcol = preview_border_col(raw)
    lines = [ln[:bcol] for ln in raw] if bcol >= 0 else raw
    preview = extract_preview(raw, bcol) if bcol >= 0 else None

    # PATH A — footer-anchored: single-select or the multi-select SELECTION screen.
    foot_idx = -1
    for i in range(len(lines) - 1, -1, -1):
        if FOOTER_RE.search(lines[i]):
            foot_idx = i
            break
    if foot_idx >= 0:
        block = option_block(lines, foot_idx)
        if block:
            first_opt_idx = block[0]
            sa = split_above(lines, first_opt_idx)
            opts = parse_options(lines, block, foot_idx)
            if opts["options"]:
                # ONLY checkbox rows mean multi-select — the ✔ Submit tab bar also
                # tops the multi-question wizard, whose per-question screens are
                # single-select.
                kind = "multi" if opts["hasCheckbox"] else "single"
                return _mk(kind, sa["header"], sa["question"], opts, preview,
                           diff=sa["diff"], body=sa["body"],
                           file_head=sa["fileHead"], plan_body=sa["planBody"])

    # PATH B — the multi-select SUBMIT/review screen (no footer; "Submit answers").
    end = len(lines)
    while end > 0 and not lines[end - 1].strip():
        end -= 1
    if end > 0:
        block = option_block(lines, end)
        if block:
            opts = parse_options(lines, block, end)
            if any(re.match(r"submit answers\b", o["label"].strip(), re.IGNORECASE) for o in opts["options"]):
                first_opt_idx = block[0]
                # Collect EVERY "● question / → answer" pair above the options, in
                # document order. Scan stops at the tab bar / rule.
                start = max(0, first_opt_idx - 40)
                for k in range(first_opt_idx - 1, start - 1, -1):
                    if is_tab_bar(lines[k]) or is_rule(lines[k]):
                        start = k + 1
                        break
                pairs = []
                for k in range(start, first_opt_idx):
                    q = re.match(r"^\s*●\s*(.+\S)\s*$", lines[k])
                    if q:
                        pairs.append({"q": q.group(1).strip(), "a": ""})
                        continue
                    c = re.match(r"^\s*→\s*(.+\S)\s*$", lines[k])
                    if c:
                        last = pairs[-1] if pairs else None
                        if last and not last["a"]:
                            last["a"] = c.group(1).strip()
                        else:
                            pairs.append({"q": "", "a": c.group(1).strip()})
                chosen = []
                for p in pairs:
                    for s in re.split(r",\s*", p["a"]):
                        s = s.strip()
                        if s:
                            chosen.append(s)
                question = (pairs[0]["q"] or None) if len(pairs) == 1 else None
                if pairs:
                    return _mk("submit", None, question, opts, preview,
                               chosen if chosen else None, pairs)

    # PATH C — a footer-LESS confirmation (e.g. /model's "Switch model?" prompt):
    # accept a ❯-cursor-bearing block of >=2 plain options as the LAST content of
    # a pane showing no composer markers anywhere.
    if end > 0 and not COMPOSER_RE.search(text):
        block = option_block(lines, end)
        if len(block) >= 2 and gap_is_skippable(lines, block[-1], end):
            opts = parse_options(lines, block, end)
            if len(opts["options"]) >= 2 and opts["cursorFound"] and not opts["hasCheckbox"]:
                first_opt_idx = block[0]
                sa = split_above(lines, first_opt_idx)
                return _mk("single", sa["header"], sa["question"], opts, preview,
                           diff=sa["diff"], body=sa["body"],
                           file_head=sa["fileHead"], plan_body=sa["planBody"])

    return None


# Back-compat / TS-name alias so callers can use either spelling.
parseAskPane = parse_ask_pane


# NOTE: queued-message detection used to live here as parse_queued() (pane scrape). It mis-parsed a SECOND
# queued message — dropping both — so it was replaced by an EVENT-BASED reader in bin/romp-kernel
# (_pending_queued, folding the transcript's queue-operation records). Claude Code DOES write those records
# the instant a message is queued, so the pane scrape was never necessary. (the user 2026-06-16)
