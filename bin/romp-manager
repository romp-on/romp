#!/usr/bin/env node
'use strict';
// romp-manager — the thin, cross-platform supervisor you launch with `romp on`.
//
// It is the durable OWNER of the romp kernel(s): you start it (foreground, like `jupyter lab`), it
// spawns each kernel via romp-serve, respawns one if it crashes OR on a restart request, and exposes
// a loopback control endpoint so ANY front end (the web dashboard's reload button, VS Code, the CLI)
// can ask it to restart a kernel — without that front end having to own the process. The manager
// itself stays up across kernel restarts, so the front ends just reconnect.
//
// This is the Jupyter shape: manager : kernel :: jupyter-server : ipython-kernel. Pure Node (no
// launchd/systemd) → identical on macOS and Linux. Front ends ATTACH to the kernel; only the manager
// owns it, so there is never an invisible orphan and never two owners fighting over the lifecycle.
//
// MULTI-KERNEL by construction: kernels live in a registry keyed by id, so a future release can run
// several kernels (e.g. different subsets of agents on different kernels) by registering more specs.
// v1 supervises one default kernel, 'main', on the standard port.
//
// CLI (dispatched from bin/romp's top-level verbs):
//   romp on        → `up`          run the manager in the foreground (Ctrl+C stops it + its kernels)
//   romp refresh   → `restart-all` restart EVERY kernel the manager owns (loops the registry)
//   romp status    → `status`      print the manager + kernel status
// (`restart [kernel]` (single) and `down`/`/stop` also exist for front ends / SIGINT — no romp verb.)

const http = require('http');
const { spawn, execFileSync } = require('child_process');
const os = require('os');
const path = require('path');
const fs = require('fs');

const HOST = '127.0.0.1';
const CONTROL_PORT = Number(process.env.ROMP_MANAGER_PORT) || 7432;
// ROMP_SERVE_PORT and ROMP_KERNEL_PORT are two spellings of the primary kernel's listen port
// (bin/romp-serve owns that seam). Accept either, so a profile renumbered with only the
// documented ROMP_KERNEL_PORT doesn't leave the manager defaulting to 29855 and spawning a
// kernel straight into the other instance's port.
const KERNEL_PORT = Number(process.env.ROMP_SERVE_PORT) || Number(process.env.ROMP_KERNEL_PORT) || 29855;

// The PRIMARY kernel's state root — where the aux-kernel registry file lives (plans/multi-kernel.md
// phase 3). Aux kernels get their OWN roots via their spec's stateDir; the registry itself is the
// primary's, because the manager is the primary's supervisor.
const STATE_ROOT = process.env.ROMP_STATE_DIR ||
  path.join(process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state'), 'romp');
const KERNELS_FILE = path.join(STATE_ROOT, 'kernels.json');

// $TMUX scrub (2026-07-20): a manager launched by hand from INSIDE a tmux session leaks $TMUX to
// its kernels and their SDK-session children — whose tmux-status hooks then resolve `#S` to
// whatever session is ATTACHED and hijack ITS @romp-session-id anchor (a live session flapping
// "dead" → bogus revive prompts). launchd spawns us clean; this makes the manual path just as
// clean at the source. Mirrors kernel/judge.py's scrub for judge subprocesses. The hook's own
// CLAUDE_CODE_ENTRYPOINT guard stays as defense-in-depth for managers older than this line.
delete process.env.TMUX;
delete process.env.TMUX_PANE;

function log(msg) { process.stderr.write('[romp-manager] ' + msg + '\n'); }

// romp-serve is the kernel launcher (rebuilds dist if stale, then execs node on it). Resolve it the
// same way the other consumers do: $ROMP_SERVE_BIN → $ROMP_DIR/bin → next to this script → the
// conventional checkout → PATH.
function rompServeBin() {
  const cands = [
    process.env.ROMP_SERVE_BIN,
    process.env.ROMP_DIR && path.join(process.env.ROMP_DIR, 'bin', 'romp-serve'),
    path.join(__dirname, 'romp-serve'),
    path.join(os.homedir(), 'GitRepos', 'romp', 'bin', 'romp-serve'),
  ].filter(Boolean);
  for (const c of cands) { try { if (fs.existsSync(c)) return c; } catch (e) { /* skip */ } }
  return 'romp-serve';
}

// ── the kernel registry (multi-kernel-ready) ───────────────────────────────
// id → { spec:{id,port,…}, child, restarts, quickCrashes, startedAt, stopping }. The default port is
// the unfiltered 'main' kernel; additional kernels come from kernels.json (durable profiles) or on
// demand via /ensure ('k<port>').

// kernels.json (plans/multi-kernel.md phase 3): the durable aux-kernel profiles —
//   { "kernels": [ { "id", "port", "postalPort"?, "stateDir"?, "claudeConfigDir"?, "tmuxSocket"? } ] }
// Parsed FRESH at every consult (never cached at manager start): the --refresh stale-manager
// incident (the user 2026-07-24) was the manager baking config once at start and then respawning
// kernels with values the disk had long since moved past. A `main` entry may override the primary's
// port for the same reason — the env-baked default is only as fresh as the manager's own start.
// Malformed entries are DROPPED with a returned error string (the caller logs it — loud, per the
// authoritative-sources rule), never silently half-applied.
function loadSpecs(file, mainPort, controlPort) {
  const specs = [{ id: 'main', port: Number(mainPort) }];
  let raw;
  try { raw = fs.readFileSync(file, 'utf8'); } catch (e) { return { specs, errors: [] }; }   // absent = single-kernel
  let doc;
  try { doc = JSON.parse(raw); } catch (e) { return { specs, errors: ['kernels.json: unreadable JSON — ignoring the whole file: ' + e.message] }; }
  const errors = [];
  const ids = new Set(['main']);
  const ports = new Set([Number(mainPort), Number(controlPort)]);
  for (const k of (Array.isArray(doc && doc.kernels) ? doc.kernels : [])) {
    const id = String((k && k.id) || '');
    const bad = (why) => errors.push(`kernels.json: dropped entry ${JSON.stringify(id || k)} — ${why}`);
    if (k && id === 'main') {                       // main override: port only (its state root is the primary's)
      const p = Number(k.port);
      const ok = Number.isInteger(p) && p >= 1024 && p <= 65535
        && (p === Number(mainPort) || !ports.has(p));
      if (ok) { specs[0].port = p; ports.add(p); } else bad('main override needs a free port in [1024,65535]');
      continue;
    }
    if (!/^[a-z0-9][a-z0-9_-]{0,31}$/.test(id)) { bad('id must be [a-z0-9][a-z0-9_-]{0,31}'); continue; }
    if (ids.has(id)) { bad('duplicate id'); continue; }
    const port = Number(k.port);
    if (!Number.isInteger(port) || port < 1024 || port > 65535 || ports.has(port)) { bad('port must be a free integer in [1024,65535]'); continue; }
    const spec = { id, port };
    if (k.postalPort != null) {
      const pp = Number(k.postalPort);
      if (!Number.isInteger(pp) || pp < 1024 || pp > 65535 || ports.has(pp)) { bad('postalPort must be a free integer in [1024,65535]'); continue; }
      spec.postalPort = pp; ports.add(pp);
    }
    for (const [field, pat] of [['stateDir', /^[/~]/], ['claudeConfigDir', /^[/~]/], ['tmuxSocket', /^[A-Za-z0-9_-]{1,64}$/]]) {
      if (k[field] != null) {
        const v = String(k[field]);
        if (!pat.test(v)) { spec._bad = field; break; }
        spec[field] = v;
      }
    }
    if (spec._bad) { bad(`${spec._bad} is malformed`); continue; }
    ids.add(id); ports.add(port); specs.push(spec);
  }
  return { specs, errors };
}

// The per-spec child env (pure, exported for tests): the profile's whole isolation story rides these
// five variables — the kernel and everything it spawns (SDK sessions, its tmux server, its postal
// bus) inherit them, so one env set at spawn scopes state, sessions, and mail per kernel.
function specEnv(spec, base, ids) {
  const env = Object.assign({}, base, {
    // BOTH spellings of the listen port, always overwritten together: `base` is the manager's own
    // env, which may carry the PRIMARY kernel's ROMP_KERNEL_PORT, and an aux kernel inheriting
    // that stale copy is how one profile's sessions end up talking to another profile's kernel.
    ROMP_SERVE_PORT: String(spec.port),
    ROMP_KERNEL_PORT: String(spec.port),
    ROMP_MANAGER_PID: String(ids.managerPid),  // → kernel's parent-death watchdog
    ROMP_MANAGER_PORT: String(ids.controlPort),
  });
  if (spec.postalPort) env.ROMP_POSTAL_PORT = String(spec.postalPort);
  if (spec.stateDir) env.ROMP_STATE_DIR = spec.stateDir;
  if (spec.claudeConfigDir) env.CLAUDE_CONFIG_DIR = spec.claudeConfigDir;
  if (spec.tmuxSocket) env.ROMP_TMUX_SOCKET = spec.tmuxSocket;
  return env;
}

const kernels = new Map();

// Front ends are configured by PORT, not id; the manager maps a port to a stable kernel id so the
// control verbs (status/restart/stop) can name it. A running kernel wins, then a kernels.json
// profile (so /ensure on a profile's port ATTACHES to that profile instead of spawning a bare
// duplicate), then the legacy shapes: the default port is 'main', anything else 'k<port>'.
function idForPort(port) {
  for (const [id, r] of kernels) if (Number(r.spec.port) === Number(port)) return id;
  const prof = loadSpecs(KERNELS_FILE, KERNEL_PORT, CONTROL_PORT).specs.find((s) => Number(s.port) === Number(port));
  if (prof) return prof.id;
  return Number(port) === KERNEL_PORT ? 'main' : 'k' + Number(port);
}

// ── manager self-staleness (the --refresh stale-manager incident, the user 2026-07-24) ────────────
// `romp refresh` restarts kernels but never this process, and a long-lived manager hands every
// respawn its START-TIME defaults — after the port renumber the file on disk was right and every
// kernel still came back on the old port, with everything REPORTING success. Detect it: stamp this
// file at start; on a refresh, a changed stamp means the respawned kernels would inherit stale
// defaults. Under a supervisor (launchd/systemd both KeepAlive/Restart=always; romp-service bakes
// ROMP_SUPERVISED=1) the manager exits instead — the supervisor respawns the NEW manager, which
// brings the kernels up fresh, so the bounce IS the refresh. Foreground (`romp on`) can only warn,
// loudly, since exiting would leave nothing to respawn it.
function fileStamp(file) {
  try { const st = fs.statSync(file); return st.mtimeMs + ':' + st.size; } catch (e) { return ''; }
}
const SELF_PATH = (() => { try { return fs.realpathSync(__filename); } catch (e) { return __filename; } })();
const SELF_STAMP = fileStamp(SELF_PATH);
function managerStale() { return fileStamp(SELF_PATH) !== SELF_STAMP; }

// Respawn backoff: a kernel that exits almost immediately is crash-looping (most often because its
// port is held by a foreign process). Escalate the delay so we never hot-spin a doomed spawn.
const QUICK_CRASH_MS = 2000;
const MAX_BACKOFF_MS = 10000;

// Restart-storm guard (the user 2026-06-24): the kernel was SIGTERM'd + respawned 300+ times in a tight
// loop because every /restart restarted 1:1 — concurrent `romp refresh`es (heavy fleet kernel work) or a
// stray refresh loop translate straight into respawns, churning every webview (a full reload) + orphaning
// SDK in-flight state. Cap it: coalesce near-simultaneous requests into ONE trailing restart, and once the
// rate looks like a storm, hold to 1 restart per cooldown + log loudly so the trigger is visible.
const RESTART_COALESCE_MS = 3000;     // collapse requests this close together into a single restart
const STORM_WINDOW_MS = 60000;        // sliding window for storm detection
const STORM_MAX = 8;                  // ≥ this many restarts in the window = a storm
const STORM_COOLDOWN_MS = 30000;      // during a storm, hold to 1 restart per this

// Quiet-window deploy refreshes (the user 2026-07-20): peers deploying with `romp refresh` bounced
// the kernel 11x in one day, and every bounce cuts whatever SDK turns are in flight (the drain
// interrupts them; the next boot resumes them with a nudge — recoverable, but each cut costs the
// model a full re-read and the user a working-session hiccup). A refresh is a DEPLOY, not an
// emergency: nothing about it needs to land mid-turn. So `?when=quiet` queues the restart and the
// manager applies it on the EVENT the fleet's SDK turns drain to zero (the kernel's /busy count,
// polled only while a refresh is pending), coalescing every refresh queued meanwhile into ONE
// bounce. The poll is the observation channel, not a heuristic: the gate itself is "no turn in
// flight". A backstop cap applies the refresh anyway if the fleet never quiets (deploys must land),
// loudly. Immediate restarts (the dashboard ↻, `--now`) behave exactly as before and satisfy any
// pending quiet request in passing.
const QUIET_POLL_MS = Number(process.env.ROMP_QUIET_POLL_MS) || 3000;
const QUIET_MAX_DEFER_MS = Number(process.env.ROMP_QUIET_MAX_DEFER_MS) || 15 * 60 * 1000;

function spawnKernel(spec) {
  // SPAWN-TIME RE-READ (the --refresh stale-manager incident): re-resolve this kernel's profile from
  // kernels.json at EVERY spawn — a config edit lands on the kernel's next restart, never waiting on
  // a manager reinstall. /ensure's dynamic 'k<port>' kernels have no file entry and keep their spec.
  const fresh = loadSpecs(KERNELS_FILE, KERNEL_PORT, CONTROL_PORT);
  for (const e of fresh.errors) log(e);
  spec = fresh.specs.find((s) => s.id === spec.id) || spec;
  const prev = kernels.get(spec.id);
  // ROMP_MANAGER_PID lets the kernel run a parent-death watchdog (_parent_watch in bin/romp-kernel):
  // if we die uncleanly (SIGKILL / crash / closed terminal) and never SIGTERM it, it sees us vanish and
  // exits itself instead of orphaning. ROMP_SERVE_PORT is the kernel's listen port; the rest of the
  // profile env (state root, Claude config dir, postal port, tmux socket) is the kernel's whole
  // isolation story (specEnv).
  const env = specEnv(spec, process.env, { managerPid: process.pid, controlPort: CONTROL_PORT });
  // stdio inherited → the kernel's own logs surface in this foreground terminal (visible owner).
  const child = spawn(rompServeBin(), ['--port', String(spec.port)], { stdio: 'inherit', env });
  kernels.set(spec.id, {
    spec, child,
    restarts: prev ? prev.restarts : 0,
    quickCrashes: prev ? prev.quickCrashes : 0,
    startedAt: Date.now(), stopping: false,
  });
  log(`kernel '${spec.id}' → :${spec.port} (pid ${child.pid})`);
  child.on('error', (e) => log(`kernel '${spec.id}' spawn error: ${e.message}`));
  child.on('exit', (code, sig) => {
    const cur = kernels.get(spec.id);
    if (!cur || cur.child !== child) return;                 // already superseded by a fresh spawn
    if (cur.stopping) { kernels.delete(spec.id); log(`kernel '${spec.id}' stopped`); return; }
    cur.restarts++;
    // crash-loop? back off. A healthy run (uptime ≥ QUICK_CRASH_MS) resets the counter.
    cur.quickCrashes = (Date.now() - cur.startedAt) < QUICK_CRASH_MS ? cur.quickCrashes + 1 : 0;
    const delay = Math.min(cur.quickCrashes * 1000, MAX_BACKOFF_MS);
    log(`kernel '${spec.id}' exited (code=${code} sig=${sig || '-'}) — respawning in ${delay}ms [#${cur.restarts}]`);
    setTimeout(() => {
      const c = kernels.get(spec.id);
      if (c && c.child === child && !c.stopping) spawnKernel(spec);   // still ours & not asked to stop
    }, delay);                                               // crash OR requested restart → bring it back
  });
}

// /ensure's worker: return the kernel for `port` if the manager already owns one, else spawn it.
// This is how a front end (configured for a port) gets a kernel there without owning the process.
function ensureKernel(port) {
  const id = idForPort(port);
  const existing = kernels.get(id);
  if (existing) return { id, port: existing.spec.port, pid: existing.child.pid, spawned: false };
  spawnKernel({ id, port: Number(port) });
  const rec = kernels.get(id);
  return { id, port: Number(port), pid: rec ? rec.child.pid : null, spawned: true };
}

// Pure storm-gate decision (time injected → unit-testable). `st` = {last, history}; decide whether to
// restart NOW or coalesce into a trailing restart, and return the updated state + an inStorm flag.
function restartGate(st, now, opts) {
  const history = (st.history || []).filter((t) => now - t < opts.stormWindowMs);
  const inStorm = history.length >= opts.stormMax;
  const minGap = inStorm ? opts.stormCooldownMs : opts.coalesceMs;
  if (st.last != null && now - st.last < minGap) {
    return { action: 'coalesce', scheduleIn: minGap - (now - st.last), inStorm, last: st.last, history };
  }
  return { action: 'restart', scheduleIn: 0, inStorm, last: now, history: [...history, now] };
}

const STORM_OPTS = { coalesceMs: RESTART_COALESCE_MS, stormWindowMs: STORM_WINDOW_MS,
  stormMax: STORM_MAX, stormCooldownMs: STORM_COOLDOWN_MS };

function restartKernel(id) {
  const rec = kernels.get(id);
  if (!rec) return false;
  rec._rs = rec._rs || { last: null, history: [] };
  const g = restartGate(rec._rs, Date.now(), STORM_OPTS);
  rec._rs.last = g.last;
  rec._rs.history = g.history;
  if (g.action === 'coalesce') {     // too soon — a single trailing restart will pick up the latest code
    if (g.inStorm && !rec._stormLogged) {
      log(`kernel '${id}': RESTART STORM — ${rec._rs.history.length}+ restarts in ${STORM_WINDOW_MS / 1000}s; holding to 1 per ${STORM_COOLDOWN_MS / 1000}s + this log. Something is spamming /restart (a refresh loop / concurrent \`romp refresh\`?).`);
      rec._stormLogged = true;
    }
    if (!rec._pending) rec._pending = setTimeout(() => { rec._pending = null; restartKernel(id); }, Math.max(50, g.scheduleIn));
    return true;
  }
  rec._stormLogged = false;
  rec.stopping = false;          // ensure the exit handler RESPAWNS rather than reaps
  rec.child.kill('SIGTERM');     // the exit handler spawns a fresh one (romp-serve rebuilds if stale)
  return true;
}

// Restart EVERY kernel the manager owns — the `romp refresh` action (loops the registry, not just
// 'main'). Returns the ids it kicked, so the caller can report them.
function restartAll() {
  const ids = [...kernels.keys()];
  for (const id of ids) restartKernel(id);
  return ids;
}

// The refresh action with the self-staleness branch (see managerStale above): supervised → exit so
// the supervisor respawns the NEW manager (the bounce IS the refresh, kernels ride along);
// foreground → warn loudly and restart the kernels anyway (stale defaults beat no refresh, and the
// warning names the fix). Used by BOTH the immediate /restart-all and the quiet-window apply.
function restartAllOrSelf() {
  if (managerStale() && process.env.ROMP_SUPERVISED) {
    const ids = [...kernels.keys()];
    log('manager binary changed since start — exiting for a supervised respawn (the fresh manager brings every kernel up on the new defaults)');
    shutdownAll(0);
    return { self: true, ids };
  }
  if (managerStale()) {
    log('WARNING: bin/romp-manager changed since this manager started — respawned kernels inherit STALE manager defaults. Restart the manager to load the new one: Ctrl+C + `romp on`, or `romp-service install`.');
  }
  return { self: false, ids: restartAll() };
}

// ── quiet-window deferral (deploy refreshes) ────────────────────────────────
// Pure decision (time injected → unit-testable). `st` = {since}; `busy` = the kernel's in-flight
// SDK turn count, or null when the kernel is unreachable — a kernel that isn't answering has no
// turns a restart could cut, so unreachable counts as quiet.
function quietGate(st, busy, now, opts) {
  if (busy === null || busy === 0) return { action: 'apply', reason: busy === null ? 'kernel unreachable' : 'quiet' };
  if (now - st.since >= opts.maxDeferMs) return { action: 'apply', reason: 'backstop cap' };
  return { action: 'wait', reason: `${busy} turn(s) in flight` };
}

let pendingQuiet = null;   // {since, count, mode:'all'|<kernel id>, timer, drainRefusedCount, drainArmedCount, drainRefusedAfterArm}

// The primary kernel's serve token. The drain arm of '/busy?drain=1' is a WRITE — it holds every
// session's new turn starts — so the kernel now requires the token for it (a drive-by loopback page
// or a tailnet client, holding no token, can no longer freeze turns by looping the poll). We are the
// same-user local daemon: read the 0600 token file (the kernel writes it under its state root on
// startup), or the env a profile baked in. Absent/unreadable → the poll still reads the count (the
// read stays auth-exempt), the drain hold just does not arm; the quiet-window gate still works off
// the count. Read fresh each poll so a kernel that reminted its token is picked up.
//
// FAIL LOUDLY, NOT DIFFERENTLY: left silent, both halves of that degrade disappear — a token-read
// failure collapses to '' with zero log, and the kernel's `draining` answer (the refusal signal
// it returns in the same /busy response) gets parsed out and dropped — so a parked deploy would
// believe new turn starts were held while the kernel armed nothing; busy never quiets, and the
// 15-minute backstop SIGTERMs the kernel MID-TURN (the exact cut the quiet window exists to
// prevent) with no line anywhere naming the cause. The degrade BEHAVIOR is deliberate
// (count-only polling keeps working; the /busy read arm needs no token) — these notices
// make it visible, once per refusal EPISODE, not per 3s poll: queueQuietRestart re-arms them when
// a fresh park begins, and an ARMED drain answer re-arms the refusal notice mid-park
// (kernelToken() reads fresh per poll, so a hold can recover when the token file
// comes back and be refused AGAIN when it goes; each transition is new information, said once).
let tokenNoticed = false;   // the serve-token read failed → said once
let drainNoticed = false;   // the kernel answered a drain=1 poll with draining:false → said once per episode
function resetDrainNotices() { tokenNoticed = false; drainNoticed = false; }

function kernelToken() {
  const t = (process.env.ROMP_SERVE_TOKEN || '').trim();
  if (t) return t;
  const file = path.join(STATE_ROOT, 'serve-token');
  try { return fs.readFileSync(file, 'utf8').trim(); }
  catch (e) {
    if (!tokenNoticed) {
      tokenNoticed = true;
      log(`kernel serve token unreadable (${file}: ${e && e.message}) — polling token-less: the busy count still reads, but the kernel will refuse to arm the drain hold`);
    }
    return '';
  }
}

function fetchBusy(port, cb, path) {
  // the PARKED quiet poll passes '/busy?drain=1' (T121): the same probe that reads the count also
  // refreshes the kernel's drain lease, so new turn starts hold while the restart is parked and
  // the count falls on turn-end events. The lease dies by itself (~12s) when this manager stops
  // polling — no off-switch to forget — and a fresh kernel boots clear by construction. The drain
  // arm is a gated WRITE, so present the token (X-Romp-Token, the local-daemon header form); a
  // plain read needs none, but carrying it costs nothing.
  // The callback gets (busy, draining): `draining` is the kernel's own answer for whether the
  // hold is armed — true/false from the response, null when unknown (an older kernel without the
  // field, an unreachable kernel, unparsable body). A drain=1 poll answered draining:false is a
  // REFUSED drain (token missing/rejected — the kernel still serves the exempt count): said once
  // per refusal episode — an armed answer after a noticed refusal logs the recovery and re-arms
  // the notice, so a hold lost AGAIN later is not swallowed by the first episode's line. `null`
  // never cries refusal — no field is no evidence, not a rejection.
  const tok = kernelToken();
  const headers = tok ? { 'X-Romp-Token': tok } : {};
  const wantDrain = /[?&]drain=1(?:&|$)/.test(path || '');
  const req = http.get({ host: HOST, port, path: path || '/busy', timeout: 2000, headers }, (res) => {
    let b = ''; res.on('data', (d) => (b += d));
    res.on('end', () => {
      let n = null, draining = null;
      try {
        const j = JSON.parse(b);
        n = Number.isFinite(j.busy) ? j.busy : null;
        draining = typeof j.draining === 'boolean' ? j.draining : null;
      } catch { n = null; }
      if (wantDrain && n !== null && draining === false && !drainNoticed) {
        drainNoticed = true;
        log(`kernel refused the drain hold (asked via /busy?drain=1 ${tok ? 'but it rejected the token' : 'holding no token'}) — new turn starts are NOT held; the quiet window runs count-only and its backstop may cut turns mid-flight`);
      } else if (wantDrain && n !== null && draining === true && drainNoticed) {
        // recovery: the hold armed after the refusal above — put that on record and re-arm the
        // notice (event-keyed: the arm is the new information), so a SECOND refusal episode in
        // the same park logs again instead of hiding behind the first episode's line.
        drainNoticed = false;
        log('kernel armed the drain hold after the refusal above — new turn starts are held from here');
      }
      cb(n, draining);
    });
  });
  req.on('timeout', () => { req.destroy(); cb(null, null); });
  req.on('error', () => cb(null, null));
}

function clearPendingQuiet() {
  if (!pendingQuiet) return;
  if (pendingQuiet.timer) clearTimeout(pendingQuiet.timer);
  pendingQuiet = null;
}

// One evaluation step of the pending-quiet chain, dependencies injected so the CHAIN is unit-testable —
// quietGate always was, but the loop around it wasn't, and that is exactly where the 2026-08-14 incident
// lived: a queued refresh logged "backstop 15 min" and then silently never applied, because the old chain
// re-armed the next tick only INSIDE the busy-probe callback — a probe whose callback never fired killed
// the whole pending refresh with zero further log lines. Contract, each piece load-bearing:
//  - SCHEDULE-FIRST: the next tick is armed before the probe, so a hung callback costs one evaluation,
//    never the chain (apply clears the pre-armed timer via clearPendingQuiet);
//  - the callback acts at most once (http 'timeout' destroys the request and 'error' follows — a double
//    fire must not evaluate twice);
//  - a throwing evaluation is LOUD and leaves the refresh queued (fail loudly, never evaporate).
//  - GENERATION-BOUND (T224): the busy answer belongs to the park that ISSUED the probe. The park is
//    captured at issue time and compared by identity at response time — a probe issued for park A
//    whose answer lands after A was cleared and park B took its place is DROPPED loudly, never fed
//    to B's gate. Before this the gate read pendingQuiet at response time, so a stale busy:0 from
//    A applied B's refresh over turns B never saw quiet, and a stale count from A held B for nothing.
//    Each queueQuietRestart mints a fresh park object, so identity IS the generation; no counter to
//    keep in step.
function quietTick(deps) {
  const { pending, fetchBusy, now, opts, apply, schedule, log } = deps;
  const park = pending();                 // the generation this probe is FOR
  if (!park) return;                      // an immediate restart satisfied it meanwhile
  schedule();                             // schedule-first: the chain outlives any probe failure
  let acted = false;
  fetchBusy((busy) => {
    if (acted) return;
    acted = true;
    const cur = pending();
    if (!cur) return;
    if (cur !== park) {
      log(`stale busy answer (${busy === null ? 'kernel unreachable' : `${busy} in flight`}) from a replaced park dropped — a probe binds to the park that issued it, never to whichever park is pending when the answer lands`);
      return;
    }
    try {
      const g = quietGate(park, busy, now(), opts);
      if (g.action === 'apply') apply(g);
    } catch (e) {
      log(`quiet-window evaluation failed (${e && e.message}) — the pending refresh stays queued`);
    }
  });
}

function queueQuietRestart(mode) {
  if (pendingQuiet) {
    pendingQuiet.count++;
    if (mode === 'all') pendingQuiet.mode = 'all';   // any 'all' request widens the pending bounce
    log(`refresh queued behind the pending one (${pendingQuiet.count} coalesced — one bounce will deliver all)`);
    return pendingQuiet.count;
  }
  pendingQuiet = { since: Date.now(), count: 1, mode, timer: null,
                   drainRefusedCount: 0, drainArmedCount: 0, drainRefusedAfterArm: 0 };
  resetDrainNotices();                   // the token/refusal notices re-arm when a fresh park begins
  log(`refresh queued — applying at the next quiet window (no SDK turn in flight; backstop ${Math.round(QUIET_MAX_DEFER_MS / 60000)} min)`);
  const tick = () => quietTick({
    pending: () => pendingQuiet,
    fetchBusy: (done) => {
      // record the kernel's drain answers as EVIDENCE ON THE PARK THAT ISSUED THIS POLL — the
      // park is captured here, at issue time, never read back from pendingQuiet when the response
      // lands (an in-flight probe from a just-cleared park must not stamp a brand-new park that
      // never polled). Refusals and arms are COUNTED, not latched into one bit: kernelToken()
      // reads fresh per poll, so a refusal can be transient (a token restored mid-park arms every
      // later poll), and the apply line below renders what this park's counts actually show.
      const park = pendingQuiet;
      const cb = (busy, draining) => {
        if (park && busy !== null) {
          if (draining === false) {
            park.drainRefusedCount++;
            // ORDER matters for the apply line (T227): two bare counters cannot tell "refused, then
            // armed" from "armed, then LOST" — a refusal that lands AFTER any arm is the loss, and
            // it is COUNTED on its own (the review's catch: a boolean here let the line report the
            // park's whole refusal total as "after arming", pre-arm refusals included)
            if (park.drainArmedCount > 0) park.drainRefusedAfterArm++;
          } else if (draining === true) park.drainArmedCount++;
        }
        done(busy);
      };
      fetchBusy(KERNEL_PORT, cb, '/busy?drain=1');   // parked → hold new turn starts (T121)
    },
    now: Date.now,
    opts: { maxDeferMs: QUIET_MAX_DEFER_MS },
    log,
    schedule: () => { pendingQuiet.timer = setTimeout(tick, QUIET_POLL_MS); },
    apply: (g) => {
      const p = pendingQuiet;
      clearPendingQuiet();               // also disarms the pre-armed next tick
      // On a backstop cut, say what this park's drain evidence shows (a wrong cause misleads the
      // reader worse than none): every answer refused → the hold never armed; refused then armed
      // → the hold arrived late, so turns started before it may still be cut; armed then LOST
      // (T227: a refusal after any arm) → the hold covered the early part of the park only, so
      // turns started after the loss may be cut. No refusals → no suffix (and draining:null
      // answers are no evidence either way, so they count nowhere).
      const cause = g.reason !== 'backstop cap' || p.drainRefusedCount === 0 ? ''
        : p.drainArmedCount === 0
          ? ' — the kernel never armed the drain hold for this park (see the refusal line above), so in-flight turns may be cut'
          : p.drainRefusedAfterArm > 0
            ? ` — the drain hold armed and was then LOST for this park (refused ${p.drainRefusedAfterArm} time(s) after arming, ${p.drainRefusedCount - p.drainRefusedAfterArm} before), so turns started after the loss may be cut`
            : ` — the drain hold was refused ${p.drainRefusedCount} time(s) before arming for this park, so turns started before it armed may be cut`;
      log(`applying deferred refresh — ${g.reason}${cause} (${p.count} request(s) coalesced, waited ${Math.round((Date.now() - p.since) / 1000)}s)`);
      if (p.mode === 'all') restartAllOrSelf(); else restartKernel(p.mode);
    },
  });
  tick();
  return 1;
}

function stopKernel(id) {
  const rec = kernels.get(id);
  if (!rec) return false;
  rec.stopping = true;
  rec.child.kill('SIGTERM');
  return true;
}

let shuttingDown = false;
function shutdownAll(exitCode) {
  if (shuttingDown) return;
  shuttingDown = true;
  clearPendingQuiet();           // never let a deferred refresh respawn what we're stopping
  log('shutting down — stopping all kernels');
  for (const id of kernels.keys()) stopKernel(id);
  // give the kernels a moment to exit, then go regardless
  setTimeout(() => process.exit(exitCode || 0), 800);
}

// ── control endpoint (loopback only) ───────────────────────────────────────
function runManager() {
  // Refuse to start a second manager — that would mean two owners fighting over the kernel port.
  probeControl((alive) => {
    if (alive) { log(`a manager is already running on :${CONTROL_PORT} (use \`romp on status|restart|down\`).`); process.exit(1); }
    startManager();
  });
}

// Start the tmux server under THIS launchd-rooted manager so every romp session inherits a clean launchd
// lineage. macOS TCC blames the GUI app at the root of the tmux SERVER's process lineage for any
// protected access, so a server first started from a VS Code integrated terminal makes every new session
// prompt "Visual Studio Code wants to access…" — even with VS Code closed (its helpers linger). Starting
// the server here at login fixes it permanently. `exit-empty off` keeps the (initially empty) server alive
// until real sessions join; it's a no-op if a server is already running (the user 2026-06-16).
// op's own credential (a service-account token in service.env, for the kernel's `op read`) must not
// become the tmux SERVER's environment: every pane the server ever creates inherits the server's
// globals, not the launching client's, so a scrubbed `romp new` client still handed the token to
// `exec claude` (review, 2026-09-05). Scrubbed only when romp is the op consumer (a reference is
// configured); a box whose sessions run `op` through Claude Code's apiKeyHelper keeps its environment.
function withoutOpCredentials(env) {
  const out = Object.assign({}, env);
  if (!out.ROMP_API_KEY_REF) return out;
  for (const k of Object.keys(out)) {
    if (k === 'OP_SERVICE_ACCOUNT_TOKEN' || k === 'OP_CONNECT_HOST' || k === 'OP_CONNECT_TOKEN' || k === 'OP_ACCOUNT' || k.startsWith('OP_SESSION_')) delete out[k];
  }
  return out;
}
function startTmuxServer() {
  try {
    execFileSync('tmux', ['start-server', ';', 'set', '-g', 'exit-empty', 'off'], { stdio: 'ignore', timeout: 5000, env: withoutOpCredentials(process.env) });
    log('tmux server ensured (launchd-rooted) — new sessions won\'t inherit a terminal\'s TCC identity');
  } catch (e) { /* tmux not installed, or a server is already up — nothing to do */ }
}

function startManager() {
  startTmuxServer();
  const server = http.createServer((req, res) => {
    const url = new URL(req.url || '/', 'http://x');
    const kid = url.searchParams.get('kernel') || 'main';
    const json = (code, obj) => { res.writeHead(code, { 'Content-Type': 'application/json' }); res.end(JSON.stringify(obj)); };
    // CSRF / drive-by gate. Legit clients (the kernel's Restart proxy, the
    // `romp on` CLI) are server-side and send NO Origin header; a browser
    // cross-site fetch/form POST DOES send an Origin it cannot forge. So reject
    // any request carrying a non-loopback Origin — otherwise a malicious tab
    // could POST /restart-all or /stop and kill the user's kernels.
    const origin = req.headers.origin;
    if (origin) {
      let okOrigin = false;
      try { const ou = new URL(origin); okOrigin = ['127.0.0.1', 'localhost', '::1'].includes(ou.hostname); } catch { okOrigin = false; }
      if (!okOrigin) return json(403, { ok: false, error: 'cross-site origin' });
    }
    if (req.method === 'GET' && url.pathname === '/status') {
      return json(200, {
        ok: true,
        manager: { pid: process.pid, controlPort: CONTROL_PORT, stale: managerStale() },
        kernels: [...kernels].map(([id, r]) => ({ id, port: r.spec.port, pid: r.child.pid, restarts: r.restarts, upSec: Math.round((Date.now() - r.startedAt) / 1000) })),
      });
    }
    if (req.method === 'POST' && url.pathname === '/ensure') {
      // A front end configured for `port` asks us to guarantee a kernel there, then attaches. We own
      // it; the front end never spawns. Idempotent: spawned:false means one was already running.
      const port = Number(url.searchParams.get('port')) || KERNEL_PORT;
      return json(200, Object.assign({ ok: true }, ensureKernel(port)));
    }
    if (req.method === 'POST' && url.pathname === '/restart-all') {
      // Every restart request is logged WITH its source (the user 2026-07-31): a run of anonymous
      // SIGTERM respawns blinked every dashboard for an hour, and this handler — the one door every
      // programmatic restart walks through — recorded nothing. The immediate path used to be silent.
      log(`restart-all requested (${url.searchParams.get('when') === 'quiet' ? 'deferred to quiet window' : 'IMMEDIATE'}) from ${req.socket.remoteAddress || '?'}`);
      if (url.searchParams.get('when') === 'quiet') {            // deploy path: land at the next quiet window
        return json(202, { ok: true, deferred: true, coalesced: queueQuietRestart('all') });
      }
      clearPendingQuiet();                                       // this bounce delivers any pending deploy too
      const r = restartAllOrSelf();                              // `romp refresh` — every kernel
      return json(200, { ok: true, restarted: r.ids, managerRestart: r.self });
    }
    if (req.method === 'POST' && url.pathname === '/restart') {
      log(`restart '${kid}' requested (${url.searchParams.get('when') === 'quiet' ? 'deferred to quiet window' : 'IMMEDIATE'}) from ${req.socket.remoteAddress || '?'}`);
      if (url.searchParams.get('when') === 'quiet') {
        if (!kernels.has(kid)) return json(404, { ok: false, error: `no kernel '${kid}'` });
        return json(202, { ok: true, deferred: true, coalesced: queueQuietRestart(kid) });
      }
      clearPendingQuiet();                                       // the dashboard ↻ satisfies a pending deploy in passing
      return restartKernel(kid) ? json(200, { ok: true, restarted: kid }) : json(404, { ok: false, error: `no kernel '${kid}'` });
    }
    if (req.method === 'POST' && url.pathname === '/stop') {
      if (url.searchParams.has('kernel')) {
        return stopKernel(kid) ? json(200, { ok: true, stopped: kid }) : json(404, { ok: false, error: `no kernel '${kid}'` });
      }
      json(200, { ok: true, stopping: 'all' });            // no ?kernel → stop everything + exit the manager
      return shutdownAll(0);
    }
    json(404, { ok: false, error: 'not found' });
  });
  server.on('error', (e) => { log(`control port :${CONTROL_PORT} unavailable: ${e.message}`); process.exit(1); });
  server.listen(CONTROL_PORT, HOST, () => {
    log(`up — control :${CONTROL_PORT} · Ctrl+C to stop`);
    const boot = loadSpecs(KERNELS_FILE, KERNEL_PORT, CONTROL_PORT);
    for (const e of boot.errors) log(e);
    for (const spec of boot.specs) spawnKernel(spec);
  });
  process.on('SIGINT', () => shutdownAll(0));
  process.on('SIGTERM', () => shutdownAll(0));
}

// ── control client (romp on restart|status|down) ───────────────────────────
function probeControl(cb) {
  const req = http.get({ host: HOST, port: CONTROL_PORT, path: '/status', timeout: 1200 }, (res) => { res.resume(); cb(res.statusCode === 200); });
  req.on('timeout', () => { req.destroy(); cb(false); });
  req.on('error', () => cb(false));
}

function control(method, pathname, kernel, params) {
  const u = new URL(`http://${HOST}:${CONTROL_PORT}${pathname}`);
  if (kernel) u.searchParams.set('kernel', kernel);
  for (const [k, v] of Object.entries(params || {})) u.searchParams.set(k, v);
  const req = http.request(u, { method, timeout: 4000 }, (res) => {
    let b = ''; res.on('data', (d) => (b += d));
    res.on('end', () => { try { process.stdout.write(JSON.stringify(JSON.parse(b), null, 2) + '\n'); } catch (e) { process.stdout.write(b + '\n'); } process.exit(res.statusCode < 400 ? 0 : 1); });
  });
  req.on('timeout', () => { req.destroy(); console.error(`romp manager did not respond on :${CONTROL_PORT}`); process.exit(1); });
  req.on('error', () => { console.error(`romp manager is not running on :${CONTROL_PORT} — start it with \`romp on\`.`); process.exit(1); });
  req.end();
}

// `romp-manager ensure` — idempotent, non-blocking auto-start: if a manager is already
// up, do nothing; otherwise spawn `up` DETACHED and return immediately. The SessionStart
// hook calls this so romp usage auto-starts the supervisor (and the kernel) — no `romp on`.
// Race-safe: the detached `up` re-probes and exits cleanly if another session won.
function ensureUp() {
  probeControl((alive) => {
    if (alive) return process.exit(0);
    spawn(process.execPath, [__filename, 'up'], { detached: true, stdio: 'ignore' }).unref();
    process.exit(0);
  });
}

// ── dispatch ────────────────────────────────────────────────────────────────
// Exported for unit tests (restartGate = the pure storm-cap decision). The CLI dispatch runs only when this
// file is executed directly, so require()-ing it from a test has no side effects.
module.exports = { restartGate, quietGate, quietTick, loadSpecs, specEnv, fileStamp,
                   kernelToken, fetchBusy, resetDrainNotices, queueQuietRestart, clearPendingQuiet };
if (require.main === module) {
  const cmd = process.argv[2];
  // `restart-all` (the `romp refresh` deploy path) bounces IMMEDIATELY by default (T160, the user
  // 2026-08-28, reversing the T121 quiet default: parked windows cost minutes per push and still cut
  // turns at the backstop). `--quiet` defers to the next quiet window explicitly — the drain lease
  // and the coalescing gate are invoked, not gone. `--now` stays accepted as the explicit spelling
  // of the default, so scripts written against either era keep working.
  if (cmd === 'restart') control('POST', '/restart', process.argv[3]);
  else if (cmd === 'restart-all') control('POST', '/restart-all', null,
    process.argv[3] === '--quiet' ? { when: 'quiet' } : {});
  else if (cmd === 'status') control('GET', '/status');
  else if (cmd === 'down') control('POST', '/stop');
  else if (cmd === 'ensure') ensureUp();
  else if (!cmd || cmd === 'up') runManager();
  else { console.error('usage: romp-manager [up | ensure | restart-all [--quiet] | restart [kernel] | status | down]'); process.exit(2); }
}
