# ── Keyboard-shortcuts help (the user 2026-06-29) ──────────────────────────────────────────────────────────
# The rail's "?" (between ↻ refresh and ⛭ settings) opens a self-contained modal IN THE SHELL document — not the
# feed iframe like settings — so it's always available regardless of which panes are open. Static content: the
# shortcuts don't change at runtime. A kernel test pins the button + the modal + the rows.
# A short, verified list (the user 2026-06-29): only the non-obvious, romp-specific keys — no per-menu
# Esc-closes filler, no slash/picker sections. Each is checked against the real handler in render.ts (the
# composer keydown + onTabKey). One flat list, no section headers.
_HELP_SHORTCUTS = [
    ("Enter", "Send message"),
    ("Shift + Enter", "New line"),
    ("Esc", "Jump to the session tabs"),
    ("← / →", "Switch session (from the tabs)"),
    ("Ctrl + C", "Interrupt the session"),
]


def _kbd(keys):
    """Wrap each key token in <kbd>, leaving the ' + ' / ' / ' separators as plain text."""
    import html as _h
    parts = re.split(r'(\s*[+/]\s*)', keys)
    out = []
    for p in parts:
        if not p:
            continue
        out.append(_h.escape(p) if re.fullmatch(r'\s*[+/]\s*', p) else "<kbd>%s</kbd>" % _h.escape(p))
    return "".join(out)


def _help_modal():
    import html as _h
    rows = "".join(
        "<div class=rhelp-row><span class=rhelp-keys>%s</span><span class=rhelp-desc>%s</span></div>"
        % (_kbd(keys), _h.escape(desc)) for keys, desc in _HELP_SHORTCUTS)
    return ("<div id=rhelp-overlay hidden>"
            "<div id=rhelp role=dialog aria-modal=true aria-label='Keyboard shortcuts'>"
            "<div class=rhelp-head><span>Keyboard shortcuts</span>"
            "<button id=rhelp-close type=button aria-label=Close>×</button></div>"
            "<div class=rhelp-body>" + rows + "</div></div></div>")


_HELP_CSS = (
    "#rhelp-overlay{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;"
    "background:rgba(0,0,0,0.55)}"
    "#rhelp-overlay[hidden]{display:none}"
    "#rhelp{background:#26262a;color:#e6e6e6;border:1px solid #3a3a3d;border-radius:10px;min-width:320px;"
    "max-width:440px;max-height:80vh;overflow:auto;box-shadow:0 12px 40px rgba(0,0,0,0.5);"
    "font:13px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}"
    ".rhelp-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 16px;"
    "border-bottom:1px solid #34343a;font-weight:650;font-size:14px;position:sticky;top:0;background:#26262a}"
    "#rhelp-close{background:none;border:0;color:#9a9a9a;font-size:20px;line-height:1;cursor:pointer;padding:0 2px}"
    "#rhelp-close:hover{color:#fff}"
    ".rhelp-body{padding:10px 16px 14px}"
    ".rhelp-row{display:flex;align-items:baseline;gap:12px;padding:4px 0}"
    ".rhelp-keys{flex:0 0 auto;min-width:104px}"
    ".rhelp-desc{flex:1 1 auto;color:#cfcfcf}"
    "#rhelp kbd{display:inline-block;background:#1c1c1f;border:1px solid #3d3d42;border-bottom-width:2px;"
    "border-radius:4px;padding:1px 6px;font:600 11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:#e6e6e6}"
    # the rail "?" — a plain question mark inside a thin circle outline (the user 2026-06-29); currentColor so it
    # tracks the rail-act idle/hover color
    ".rhelp-q{display:flex;align-items:center;justify-content:center;width:13px;height:13px;border:1.3px solid "
    "currentColor;border-radius:50%;font:600 9px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}"
)


