# The romp-tl-* styles, verbatim from the obsidian/VS-Code timeline wrapper.
TIMELINE_CSS = """:root{--text-muted:#9aa0a6;--text-faint:#6e7681;}#host{width:100%;}
.romp-tl-top{display:flex;align-items:center;gap:12px;padding:2px 0 8px;flex:0 0 auto;}
