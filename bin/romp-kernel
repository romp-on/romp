// The settings modal is full-WINDOW, but the gear lives in the feed iframe — so ask the shell to expand the
// feed iframe to the whole screen while the modal is open (it restores on close). No-op outside the shell.
function feedFull(on){try{if(window.parent!==window)window.parent.postMessage({romp:'settings',on:!!on},'*');}catch(e){}}
// While the modal is open: hide the feed's OWN content + go transparent (rs-modal-open) so the expanded
// (full-window) feed iframe shows the dashboard's three panes THROUGH it — the modal floats over the whole
// layout, dimmed, instead of blowing the feed cards up full-screen (the user 2026-06-23).
function setModalCls(on){var de=document.documentElement,m='rs-modal-open';
if(on){de.classList.add(m);document.body.classList.add(m);}else{de.classList.remove(m);document.body.classList.remove(m);}}
function closeSettings(){p.hidden=true;setModalCls(false);feedFull(false);}
function openSettings(){if(!p.hidden){closeSettings();return;}   // the rail gear toggles the modal (the user 2026-06-25)
p.hidden=false;setModalCls(true);feedFull(true);var s=load();cc.checked=!!s.compact;db.checked=!!s.debug;if(gb)gb.checked=s.showBranch!==false;if(cg)cg.checked=s.collapseGaps!==false;cmBuild();cmPaint(s.colormap||'aurora');if(bk)bk.value=s.backend||'tmux';if(dd)dd.value=s.defaultDir||'';fill();}
if(g)g.onclick=function(e){e.stopPropagation();openSettings();};   // the gear is hidden now; the rail drives it via a message
