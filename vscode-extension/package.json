{
  "name": "romp-chat-view",
  "displayName": "romp Chat View",
  "description": "Read-only, nicely-rendered live view of Claude Code (romp) sessions, styled like the official Claude Code panel.",
  "version": "0.4.337",
  "publisher": "romp",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:rompChat",
    "onWebviewPanel:rompFeed",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rompChat.open",
        "title": "romp: Open",
        "icon": "media/romp-swirl-glyph.svg"
      },
      {
        "command": "rompChat.addSession",
        "title": "romp: Add Session Tab",
        "icon": "$(add)"
      },
      {
        "command": "rompChat.openCurrent",
        "title": "romp: View This Transcript File"
      },
      {
        "command": "rompChat.nextTab",
        "title": "romp: Next Tab"
      },
      {
        "command": "rompChat.prevTab",
        "title": "romp: Previous Tab"
      },
      {
        "command": "rompChat.pickSession",
        "title": "romp: Pick a Session"
      },
      {
        "command": "rompChat.openFeed",
        "title": "romp: Open Feed",
        "icon": "$(list-unordered)"
      },
      {
        "command": "rompChat.openTimeline",
        "title": "romp: Open Timeline"
      },
      {
        "command": "rompChat.openFleet",
        "title": "romp: Open Outline"
      },
      {
        "command": "rompChat.citeInComposer",
        "title": "romp: Cite File in Chat Composer"
      },
      {
        "command": "rompChat.openSessionWorktree",
        "title": "romp: Open Session Worktree"
      },
      {
        "command": "rompChat.diffSessionChanges",
        "title": "romp: Diff Session Changes"
      },
      {
        "command": "rompChat.menu",
        "title": "romp: Menu",
        "icon": "media/romp-swirl-glyph.svg"
      },
      {
        "command": "rompChat.updateExtension",
        "title": "romp: Update Extension"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "rompPanel",
          "title": "romp",
          "icon": "media/romp-swirl-glyph.svg"
        }
      ]
    },
    "views": {
      "rompPanel": [
        {
          "type": "webview",
          "id": "rompTimeline",
          "name": "Timeline",
          "icon": "media/romp-swirl-glyph.svg"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "rompChat.citeInComposer",
          "group": "romp@1",
          "when": "resourceScheme == 'file'"
        }
      ],
      "editor/title": [
        {
          "command": "rompChat.open",
          "group": "navigation@99"
        },
        {
          "command": "rompChat.openFeed",
          "group": "navigation@98",
          "when": "activeWebviewPanelId == 'rompChat' || activeWebviewPanelId == 'rompFeed'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rompChat.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.prevTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.nextTab",
        "mac": "ctrl+cmd+alt+right",
        "when": "activeWebviewPanelId == 'rompChat'"
      },
      {
        "command": "rompChat.prevTab",
        "mac": "ctrl+cmd+alt+left",
        "when": "activeWebviewPanelId == 'rompChat'"
      }
    ],
    "configuration": {
      "title": "romp",
      "properties": {
        "romp.kernelPort": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port of the romp kernel this VS Code window attaches to. Point different windows at different ports to view different kernels (each kernel scopes its own group of agents). If no kernel is running on this port, VS Code asks the `romp up` manager to start one — VS Code never spawns the kernel itself. Unset → `$ROMP_SERVE_PORT` or **29855**."
        },
        "romp.managerPort": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Control-endpoint port of the `romp up` manager, used to ensure a kernel exists on `#romp.kernelPort#`. Unset → `$ROMP_MANAGER_PORT` or **7432**."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production",
    "test": "node esbuild.js --tests && node --test 'out-tests/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.10",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.1",
    "marked": "^12.0.2",
    "three": "^0.185.1",
    "ws": "^8.21.0"
  }
}
